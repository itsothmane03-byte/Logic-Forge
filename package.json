{
  "name": "fallacy-forge",
  "version": "2.5.0",
  "private": true,
  "description": "Spot weak arguments, choose stronger revisions, and practice deduction. Free reasoning activities, all in the browser.",
  "license": "MIT",
  "author": "itsothmane03-byte",
  "homepage": "https://itsothmane03-byte.github.io/Logic-Forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsothmane03-byte/Logic-Forge.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "content": "node scripts/build-bank.mjs",
    "content:check": "node scripts/validate-content.mjs --allow-partial",
    "content:fixtures": "node scripts/build-bank.mjs --fixtures --allow-partial"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
